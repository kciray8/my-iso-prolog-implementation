<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} -- %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="iaroslav.baranov.tracklog.processor.Processor" level="DEBUG"/>
    <logger name="iaroslav.baranov.tracklog.processor.execution.stack.ExecutionStack" level="DEBUG"/>
    <logger name="iaroslav.baranov.tracklog.service.unification.UnificationService" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>